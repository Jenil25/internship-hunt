# Copy to .env.local (or .env) and fill in. Never commit the filled-in file.
# For the deployed site, set these same keys in Vercel → Project Settings → Environment Variables.

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Same value. Kept for NextAuth v4-style lookups.
NEXTAUTH_SECRET=

# ─── PostgreSQL ───────────────────────────────────────────────────────
# Local dev: the pgvector/pgvector:pg16 container (values below).
# Supabase: copy from Connect → Transaction pooler. Looks like
#   PG_HOST=aws-1-<region>.pooler.supabase.com
#   PG_PORT=6543
#   PG_DATABASE=postgres
#   PG_USER=postgres.<project-ref>
# Avoid the direct db.<ref>.supabase.co host — it is IPv6-only and will not
# resolve from most machines or from Vercel's build environment.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=applai_db
PG_USER=applai_user
PG_PASSWORD=

# ─── n8n ──────────────────────────────────────────────────────────────
# The pipeline webhook the /upload page POSTs to.
# Local: http://localhost:5678/webhook/<path>   Prod: your Hetzner n8n URL.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# ─── LaTeX compilation service ────────────────────────────────────────
# backend/latex-service/server.py, or its container.
LATEX_SERVICE_URL=http://localhost:3001

# ─── AWS S3 (resume storage) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Legacy local file fallback ───────────────────────────────────────
# Only used for pre-S3 jobs whose resume_file_path starts with /files/.
# Safe to leave unset on new installs.
FILES_BASE_PATH=./local_files
